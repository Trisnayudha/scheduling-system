<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Payment Reminder - Sponsor &amp; Exhibitor Portal</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body style="margin:0;padding:0;background:#f6f7fb;font-family:Arial,Helvetica,sans-serif;color:#111111;">
  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background:#f6f7fb;padding:20px 0;">
    <tr><td align="center">
      <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="600" style="max-width:600px;width:100%;background:#ffffff;border:2px solid #00537a;border-radius:4px;border-collapse:collapse;overflow:hidden;">
        <tr><td align="center" style="padding:24px 24px 0;"><img src="https://portal.indonesiaminer.com/logo_2027.png" alt="Indonesia Miner 2027" width="160" style="display:block;width:160px;height:auto;border:0;"></td></tr>
        <tr><td style="padding:24px;font-size:14px;line-height:1.6;">
          <p style="font-size:16px;font-weight:bold;margin:0 0 16px;">Dear {{name}},</p>
          <p style="margin:0 0 16px;">This is a payment reminder for additional order <strong>{{invoice_code}}</strong> for Indonesia Miner Conference &amp; Exhibition 2027 in the Sponsor &amp; Exhibitor Portal. Your payment is due in 12 hours. Please complete your payment before the payment link expires to secure your items.</p>
          <p style="margin:0 0 20px;"><strong>Complete Payment:</strong> <a href="{{pay_link}}" target="_blank" rel="noopener" style="color:#00537a;text-decoration:underline;word-break:break-all;">{{pay_link}}</a></p>
          <p style="margin:0 0 20px;">Have a question / need assistance, please contact our operational team at <a href="mailto:riska@indonesiaminer.com" style="color:#00537a;text-decoration:none;font-weight:bold;">riska@indonesiaminer.com</a> or <a href="tel:+6281398670330" style="color:#00537a;text-decoration:none;font-weight:bold;">+62 813 9867 0330</a>.</p>
          <p style="margin-top:24px;margin-bottom:0;">Warm regards,<br><strong>Indonesia Miner Team</strong></p>
        </td></tr>
        <tr><td style="background:#fafafa;color:#6b7280;font-size:12px;padding:16px 24px;border-top:1px solid #e5e7eb;">You receive this email because you placed an additional order for Indonesia Miner Conference &amp; Exhibition 2027 in the Sponsor &amp; Exhibitor Portal. If you have completed payment recently, you can ignore this message.</td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
