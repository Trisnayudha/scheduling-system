<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Payment Reminder - Indonesia Miner 2027</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body style="margin:0;padding:0;background:#f6f7fb;font-family:Arial,Helvetica,sans-serif;color:#111111;">

  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background:#f6f7fb;padding:20px 0;">
    <tr>
      <td align="center">
        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="600" style="max-width:600px;background:#ffffff;border:2px solid #00537a;border-radius:4px;border-collapse:collapse;overflow:hidden;">

          <!-- Content -->
          <tr>
            <td style="padding:24px;font-size:14px;line-height:1.6;">
              <p style="font-size:16px;font-weight:bold;margin:0 0 16px;">Dear {{name}},</p>

              <p style="margin:0 0 16px;">
               This is a payment reminder for your Indonesia Miner Conference & Exhibition 2027 registration. Your payment is due in 12 hours. Please complete your payment before the payment link expires to secure the current rate and confirm your registration.
                </p>

              <p style="margin:0 0 20px;">
                <strong>Complete Payment:</strong> <a href="{{pay_link}}" target="_blank" rel="noopener" style="color:#00537a;text-decoration:underline;word-break:break-all;">{{pay_link}}</a>
              </p>

              <p style="margin:0 0 20px;">
                Have a questions/ need assistance, please contact our support team at <a href="mailto:info@indonesiaminer.com" style="color:#00537a;text-decoration:none;font-weight:bold;">info@indonesiaminer.com</a>
              </p>

              <p style="margin-top:24px;margin-bottom:0;">
                Warm regards,<br>
                <strong>Indonesia Miner Team</strong>
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background:#fafafa;color:#6b7280;font-size:12px;padding:16px 24px;border-top:1px solid #e5e7eb;">
              You receive this email because you started a registration for Indonesia Miner 2027.
              If you have completed payment recently, you can ignore this message.
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
