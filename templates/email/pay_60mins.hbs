<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <title>60 Minutes Left</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
</head>

<body style="margin:0;padding:0;background:#ffffff;font-family:Arial,Helvetica,sans-serif;color:#111827;">
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
    <tr>
      <td align="center" style="padding:24px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="640" style="max-width:640px;">
          <tr>
            <td style="font-size:14px;line-height:1.6;">
              <p>Dear {{name}},</p>

              <p>
                This is your final reminder that payment for your <strong>{{ticket_promo_name}}</strong> to the
                Indonesia Miner Conference &amp; Exhibition 2026 is due within the next <strong>60 minutes</strong>.
              </p>

              <p>Please complete your payment promptly to secure your ticket at the special discounted rate.</p>
              <p>
                <strong>Proceed to Payment:</strong>
                <a href="{{pay_link}}" target="_blank" rel="noopener">{{pay_link}}</a>
              </p>

              <p>If you have any questions or need assistance, please don't hesitate to contact us.
              </p>

              <p style="margin-top:20px;">
                Warm regards,<br>
                <strong>Indonesia Miner Team</strong>
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>

</html>